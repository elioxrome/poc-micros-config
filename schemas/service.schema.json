{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "service.schema.json",
  "title": "Metadatos de un micro (microservices/<micro>/service.yaml)",
  "description": "Datos del micro que no dependen del entorno. 'name' debe coincidir con el nombre de la carpeta.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "description", "owner", "domain", "stack"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "description": { "type": "string", "minLength": 1 },
    "owner": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "domain": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "stack": { "enum": ["java", "python", "node", "go", "dotnet"] }
  }
}
